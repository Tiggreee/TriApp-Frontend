{
  "name": "triapp",
  "private": true,
  "version": "2.0.0",
  "description": "Renata's Finder — kid-friendly monolith (web + server)",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "start": "pnpm --filter @triapp/server start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  }
}
